# ===================================================
# Autonomous Payroll Agents - Environment Variables
# ===================================================

# Network & RPC Configuration
# e.g. Sepolia testnet or local EVM node
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111

# USDT / Test Token Contract Address on the selected network
# Sepolia USDT / Mock USDT address
USDT_TOKEN_ADDRESS=0xaA8E23Fb1079EA71e0a56F48a2aA51851D8433D0

# Company Wallet (Payer) - 12/24 words BIP-39 Seed Phrase (DO NOT USE REAL FUNDS)
COMPANY_SEED_PHRASE="test test test test test test test test test test test junk"

# Employee Wallet (Payee) - 12/24 words BIP-39 Seed Phrase
EMPLOYEE_SEED_PHRASE="abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"

# Server & Agent Ports
PORT=3000
COMPANY_AGENT_URL=http://localhost:3000

# WDK Policy Configurations
MAX_SALARY_PER_TX_USDT=10000
MONTHLY_PAYROLL_BUDGET_USDT=50000
